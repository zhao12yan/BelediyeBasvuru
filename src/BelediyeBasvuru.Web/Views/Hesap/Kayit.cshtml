@* H2-K1: Vatandaş kayıt sayfası. Adres: /Hesap/Kayit. Rol seçimi BİLEREK yoktur; herkes Vatandaş olarak kaydolur. *@
@model KayitModeli
@{
    ViewData["Title"] = "Kayıt Ol";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-4">Vatandaş Kaydı</h1>
        <form asp-controller="Hesap" asp-action="Kayit" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="AdSoyad" class="form-label"></label>
                <input asp-for="AdSoyad" class="form-control" autocomplete="name" />
                <span asp-validation-for="AdSoyad" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Eposta" class="form-label"></label>
                <input asp-for="Eposta" class="form-control" autocomplete="email" />
                <span asp-validation-for="Eposta" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Parola" class="form-label"></label>
                <input asp-for="Parola" class="form-control" autocomplete="new-password" aria-describedby="parolaKurali" />
                <div id="parolaKurali" class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermelidir.</div>
                <span asp-validation-for="Parola" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ParolaTekrar" class="form-label"></label>
                <input asp-for="ParolaTekrar" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ParolaTekrar" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-bb-birincil w-100">Kayıt Ol</button>
        </form>
        <p class="mt-3 mb-0">Zaten hesabınız var mı? <a asp-controller="Hesap" asp-action="Giris">Giriş yapın</a>.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
