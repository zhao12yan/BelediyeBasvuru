@* H2-K1: Giriş sayfası. Adres: /Hesap/Giris. Kişi 2 bu formun alanlarını (Eposta, Parola, BeniHatirla, DonusAdresi)
   kendi tasarımına taşıyabilir; form asp-controller="Hesap" asp-action="Giris" method="post" olmalıdır. *@
@model GirisModeli
@{
    ViewData["Title"] = "Giriş Yap";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-4">Giriş Yap</h1>
        <form asp-controller="Hesap" asp-action="Giris" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input asp-for="DonusAdresi" type="hidden" />
            <div class="mb-3">
                <label asp-for="Eposta" class="form-label"></label>
                <input asp-for="Eposta" class="form-control" autocomplete="username" />
                <span asp-validation-for="Eposta" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Parola" class="form-label"></label>
                <input asp-for="Parola" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Parola" class="text-danger small"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="BeniHatirla" class="form-check-input" />
                <label asp-for="BeniHatirla" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-bb-birincil w-100">Giriş Yap</button>
        </form>
        <p class="mt-3 mb-0">Hesabınız yok mu? <a asp-controller="Hesap" asp-action="Kayit">Vatandaş olarak kayıt olun</a>.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
